# =====================================================================
#  LIAISON AVEC LE SITE (FRONTEND) : les 3 adresses à connaître
#
#  Ce serveur (backend)  : http://localhost:3000        (PORT ci-dessous)
#  Le site (frontend)    : http://localhost:5173        (dossier manager-ia-frontend, `npm start`)
#  Pour qu'ils se parlent :
#     - côté site     : fichier .env du frontend  ->  API_BASE=http://localhost:3000
#     - côté serveur  : variable ALLOWED_ORIGINS ci-dessous = l'adresse du site
#
#  En ligne (exemples) :
#     - Site et serveur sur le MÊME domaine (le plus simple, recommandé) :
#           frontend .env : API_BASE=            (vide)    | ici : ALLOWED_ORIGINS vide, COOKIE_SAMESITE=lax
#           (copiez le contenu de manager-ia-frontend dans le dossier "public" de ce serveur)
#     - Site sur un AUTRE domaine (ex. site https://manager-ia.com, API https://api.manager-ia.com) :
#           frontend .env : API_BASE=https://api.manager-ia.com
#           ici : ALLOWED_ORIGINS=https://manager-ia.com   COOKIE_SAMESITE=none   COOKIE_SECURE=true
# =====================================================================

# =====================================================================
#  Brij-IA : variables d'environnement
#  Copiez ce fichier en ".env" (en local) ou saisissez ces variables
#  dans le tableau de bord de votre hébergeur (Render, Railway...).
#  NE PUBLIEZ JAMAIS le fichier .env (il contient vos secrets).
# =====================================================================

# --- Général -----------------------------------------------------------
# "production" sur le serveur en ligne, laissez vide en local.
NODE_ENV=
# Port d'écoute (Render/Railway le fournissent souvent automatiquement).
PORT=3000
# Nombre de proxys devant le serveur : Render/Railway/nginx seul = 1 ; Vercel (redirection /api) puis Render = 2. Mettre 0 en local.
# Sert à connaître la vraie adresse IP des visiteurs pour les limites de débit.
TRUST_PROXY=
# Adresse publique du site (facultatif, ex : https://manager-ia.com).
SITE_URL=http://localhost:5173

# --- Base de données PostgreSQL (OBLIGATOIRE) ---------------------------
# Neon (https://neon.tech) : créez un projet, puis copiez l'adresse « Pooled connection » du tableau de bord.
# Exemple : postgresql://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Adresse « Direct connection » de Neon (sans -pooler) : utilisée seulement pour appliquer les migrations. Facultatif.
DATABASE_URL_UNPOOLED=
# false seulement pour un PostgreSQL local sans SSL (jamais sur Neon).
DATABASE_SSL=
# Nombre maximal de connexions du serveur (10 suffit largement ; Neon gratuit accepte beaucoup via l'adresse pooled).
DB_POOL_MAX=10

# --- Sécurité ----------------------------------------------------------
# OBLIGATOIRE en production : une longue phrase secrète aléatoire (48+ caractères).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Sites autorisés à appeler l'API s'ils sont sur un AUTRE domaine (séparés par des virgules).
# Exemple : https://manager-ia.com,https://www.manager-ia.com
# Laissez vide si le frontend est servi par ce même serveur (dossier public/).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# lax (frontend et API sur le même site/domaine) ou none (frontend sur un autre domaine).
COOKIE_SAMESITE=lax
# true/false. Par défaut : true en production. Obligatoire (true) si COOKIE_SAMESITE=none.
COOKIE_SECURE=

# Clé qui chiffre les jetons WhatsApp / Messenger enregistrés (48+ caractères aléatoires). CONSERVEZ-LA : sans elle, ils deviennent illisibles.
DATA_KEY=

# --- Administrateur ----------------------------------------------------
# Identifiants de la page /admin. Choisissez un mot de passe LONG et unique.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Où l'administrateur reçoit les notifications.
ADMIN_EMAIL=tendabrandon9@gmail.com
ADMIN_WHATSAPP=237653621388

# --- E-mail (SMTP) -----------------------------------------------------
# Exemple Gmail : # Inscription avec code par e-mail (1 minute) : auto = actif dès que SMTP_HOST est rempli ; on / off pour forcer.
SIGNUP_VERIFY=auto
SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (ou 465),
# SMTP_USER = votre adresse Gmail, SMTP_PASS = MOT DE PASSE D'APPLICATION (pas votre mot de passe normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adresse d'expéditeur affichée, ex : Brij-IA <tendabrandon9@gmail.com>
SMTP_FROM=

# --- WhatsApp Business Cloud API (Meta) : notifications admin ET agent client ---
# Identifiant du numéro WhatsApp (Phone number ID) et jeton d'accès permanent.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
# Nom exact du modèle de message approuvé par Meta (voir README).
WHATSAPP_TEMPLATE=nouvelle_notification

# --- Agent de service client (WhatsApp / Messenger / Instagram) ----------
# Mot de votre choix, à recopier dans Meta lors de la configuration du webhook.
META_VERIFY_TOKEN=
# "Clé secrète de l'app" (App Secret) de votre application Meta : sert à vérifier les signatures.
META_APP_SECRET=
# Jeton d'accès de la Page Facebook (Messenger) / du compte Instagram lié.
PAGE_ACCESS_TOKEN=
# Fichier décrivant votre entreprise (copiez business.example.json en business.json).
BUSINESS_FILE=business.json
# Heures pendant lesquelles le robot se tait après qu'un client a demandé un humain.
HANDOFF_SILENCE_HOURS=2

# --- Assistant IA (Anthropic / Claude) ---------------------------------
# Sans clé, l'assistant du site répond "indisponible" (le site utilise alors son plan B).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# --- Changer de fournisseur d'IA (facultatif) -------------------------------------------------------------
# AI_PROVIDER=anthropic          # ou « openai » = tout service compatible OpenAI (OpenAI, Mistral, Groq, Gemini compatible, Ollama local…)
# AI_API_KEY=                    # remplace ANTHROPIC_API_KEY si défini
# AI_MODEL=                      # ex. mistral-small-latest, gpt-4o-mini…
# AI_BASE_URL=                   # ex. https://api.mistral.ai/v1  ou  http://localhost:11434/v1 (Ollama)
# AI_MODEL_FAST=claude-haiku-5-5 # petit modèle économique pour l'assistant du site et l'agent client
# AI_PROMPT_CACHE=1              # 0 pour désactiver la mise en cache des consignes (Anthropic)
# Nombre maximum de questions à l'assistant par visiteur (adresse IP) et par jour.
ASSISTANT_DAILY_LIMIT=200

# --- Paiements ---------------------------------------------------------
# Campay (paiement automatique MTN/Orange). Laissez vide pour le paiement manuel.
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# https://www.campay.net/api (réel)  ou  https://demo.campay.net/api (essais)
CAMPAY_BASE_URL=https://www.campay.net/api
# Paiement manuel : vos numéros qui reçoivent l'argent et le nom du titulaire.
MTN_NUMBER=
ORANGE_NUMBER=
PAYMENT_HOLDER_NAME=
# Prix en FCFA et durée d'une offre (valeurs par défaut du site).
PRICE_PRO=50000
PRICE_PROMAX=75000
PLAN_DURATION_DAYS=30

# --- WhatsApp par entreprise : chaque entreprise saisit ses propres identifiants Meta dans l'application (chiffrés avec DATA_KEY, sinon JWT_SECRET) ---
# DATA_KEY=            # une phrase secrète longue et unique (à ne jamais changer ensuite, sinon les jetons enregistrés deviennent illisibles)
# META_GRAPH_URL=https://graph.facebook.com/v21.0   # inutile à changer (sert aux tests)

# --- Messages vocaux : transcription en texte (service compatible OpenAI : OpenAI, Groq…). Vide = désactivée (la dictée du navigateur reste possible) ---
# STT_API_KEY=
# STT_BASE_URL=https://api.openai.com/v1   # ou https://api.groq.com/openai/v1
# STT_MODEL=whisper-1                       # ou whisper-large-v3 (Groq)
# STT_LANGUAGE=                             # vide = détection automatique

# --- Envoi d'e-mails aux clients (SMTP) : à renseigner pour activer le bouton « Envoyer par e-mail » (voir aussi SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM plus haut) ---
# MAIL_DAY_FREE=5
# MAIL_DAY_PRO=50
# MAIL_DAY_PROMAX=150
# MAIL_DAY_MEGAPRO=300
# MAIL_DAY_ILLIMITE=500
# AI_PER_MINUTE=20   # messages IA par minute et par adresse IP (anti-abus)

# --- Offres : prix (FCFA / mois) et messages IA par période d'abonnement pour toute l'organisation (valeurs par défaut indiquées) ---
# PRICE_PRO=50000
# PRICE_PROMAX=75000
# PRICE_MEGAPRO=100000
# PRICE_ILLIMITE=150000
# WS_AI_FREE=40
# WS_AI_PRO=1000
# WS_AI_PROMAX=2000
# WS_AI_MEGAPRO=3500
# WS_AI_ILLIMITE=6000

# Indicatif ajouté aux numéros locaux à 9 chiffres pour les messages WhatsApp sortants (Cameroun : 237).
DEFAULT_COUNTRY_CODE=237

# --- Réponses en message vocal (synthèse vocale) ---------------------
# Service compatible OpenAI (/audio/speech). Si vide, on réutilise STT_API_KEY / STT_BASE_URL.
# Coût indicatif : quelques FCFA par réponse vocale (chaque réponse vocale compte aussi comme un message IA).
# TTS_API_KEY=
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_MODEL=tts-1
# TTS_VOICE=alloy        # alloy, echo, fable, onyx, nova, shimmer

# --- Messenger et Instagram : envoi de photos, vidéos et voix -----------
# Meta télécharge ces fichiers à une adresse de CE serveur (lien signé, valable 15 minutes).
# Indiquez l'adresse publique HTTPS du serveur, ex. https://api.manager-ia.com (à défaut, SITE_URL est utilisée).
# Sans adresse publique (essai en local), le texte part mais pas les fichiers sur Messenger et Instagram.
API_PUBLIC_URL=

# --- Centre de sécurité ---
# Points d'abus (par adresse IP, sur 15 minutes) à partir desquels l'adresse est bloquée automatiquement (1 h, puis 24 h en cas de récidive).
# Plus bas = plus strict. Les adresses locales / privées ne sont jamais bloquées automatiquement (SECURITY_BAN_PRIVATE=1 pour les inclure, essais seulement).
SECURITY_BAN_SCORE=40

# --- E-mail par API web (Brevo) : à utiliser si l'hébergeur bloque le SMTP (plan gratuit de Render) ---
# BREVO_API_KEY=         # clé « API v3 » créée dans Brevo (SMTP et API > Clés API). Active l'envoi des e-mails et des codes d'inscription.
# SMTP_FROM=Brij-IA <votre-adresse-validee@exemple.com>   # adresse d'expéditeur validée chez Brevo (Senders)
# --- IA avec Gemini (mode compatible OpenAI) ---
# AI_PROVIDER=openai
# AI_API_KEY=            # clé Google AI Studio
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.8-flash   # vérifiez le nom courant dans Google AI Studio
# AI_AUTH_HEADER=x-goog-api-key  # clés Google « AQ. » : la clé part dans cet en-tête au lieu de « Authorization: Bearer »
# AI_REASONING_EFFORT=low     # si le modèle réfléchit trop longtemps (erreur « operation was aborted ») : minimal ou low
# AI_TIMEOUT_MS=45000         # délai maximal d'attente de l'IA en millisecondes (5000 à 120000)

# --- Connexion WhatsApp en un clic (Embedded Signup de Meta) : désactivée tant que ces 3 lignes + META_APP_SECRET ne sont pas remplies ---
# Voir le README (section « Connexion WhatsApp en un clic ») : prérequis Meta (entreprise vérifiée, application Live, revue des permissions).
# META_APP_ID=                    # identifiant de l'application Meta
# META_APP_SECRET=                # (déjà utilisé plus haut) secret de l'application : vérifie les signatures et échange les codes
# META_EMBEDDED_CONFIG_ID=        # identifiant de configuration « Facebook Login for Business » (produit WhatsApp Embedded Signup)
# META_WEBHOOK_VERIFY_TOKEN=      # texte au choix, à coller aussi dans Meta pour le webhook commun /api/webhooks/whatsapp

# --- WhatsApp par QR code (méthode NON officielle, risque de blocage du numéro : voir README) ---
# WA_QR_ENABLED=1                 # 0 pour désactiver la connexion par QR code
# WA_QR_MAX_SESSIONS=20           # sessions WhatsApp ouvertes en même temps sur ce serveur
# WA_QR_SEND_PER_MIN=20           # messages envoyés par minute et par organisation
# WA_QR_SEND_PER_DAY=1000         # messages envoyés par jour et par organisation
# WA_QR_MAX_QUEUE=60              # messages en attente d'envoi par organisation
# WA_QR_MAX_AGE_MIN=10            # les messages reçus plus anciens (reconnexion) sont ignorés
# META_CHANNELS=0                 # 1 = réafficher l'interface Meta (WhatsApp Cloud, un clic, Messenger, Instagram)

# --- Encaissement des factures (Vague 1) ---
# Aucune variable nouvelle : le suivi Mobile Money des factures est MANUEL (opérateur, référence de transaction, statut « à vérifier » / confirmé).
# CAMPAY_USERNAME / CAMPAY_PASSWORD (plus haut) servent à encaisser les ABONNEMENTS de la plateforme sur son propre compte Campay :
# ils ne sont volontairement PAS utilisés pour les factures des organisations (l'argent irait au mauvais compte).
# Une « demande de paiement » automatique par facture demanderait que chaque organisation enregistre ses propres identifiants Campay (non fait).
