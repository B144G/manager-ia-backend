{
  "name": "manager-ia-backend",
  "version": "1.0.0",
  "description": "Serveur (API) de MANAGER-IA : comptes, abonnements et paiements, espace de travail (stock, clients, RH, comptabilité), assistant IA, WhatsApp / Messenger / Instagram, administration. PostgreSQL (Neon) — hébergeable sur Render.",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:ai && npm run test:webhooks && npm run smoke && npm run smoke:signup && npm run smoke:security && npm run smoke:ws",
    "smoke": "node scripts/smoke.js",
    "smoke:ws": "node scripts/smoke-workspace.js",
    "smoke:signup": "node scripts/smoke-signup.js",
    "smoke:security": "node scripts/smoke-security.js",
    "backup": "node scripts/backup.js",
    "db:import-sqlite": "node scripts/import-sqlite.js",
    "db:check": "node scripts/db-check.js",
    "test:ai": "node scripts/test-ai-adapter.js",
    "test:webhooks": "node scripts/test-webhooks.js",
    "eval:ai": "node scripts/eval-ai.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1"
  },
  "license": "UNLICENSED",
  "keywords": [
    "manager-ia",
    "erp",
    "whatsapp",
    "ia",
    "ohada"
  ],
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  }
}
